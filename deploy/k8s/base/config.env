# Non-secret configuration for both roles.
#
# Consumed by configMapGenerator in kustomization.yaml, which appends a content
# hash to the ConfigMap name and rewrites every reference to it. That is what
# makes a config change actually take effect: editing a plain ConfigMap updates
# the mounted values but restarts nothing, so the change looks applied while
# every pod carries on with the old settings. A hashed name changes the pod
# template, which rolls the pods.
#
# Only values that are safe in a screenshot belong here — anyone with
# `get configmap` in this namespace can read them. Credentials go in the Secret
# (see secret.example.yaml).

HUB_ENV=production
HUB_LOG_FORMAT=json
HUB_LOG_LEVEL=INFO

# State directory. Must match the volumeMount in the workloads, and must be
# writable: the containers run with a read-only root filesystem, so this and
# /tmp are the only paths the process can write to.
HUB_DATA_DIR=/data

# --- trading ---
HUB_AUTO_ENGINE=1
HUB_USE_LIVE_DATA=1
# Binance answers HTTP 451 to most cloud and datacenter IP ranges, so the
# default venue is Kraken, which serves them.
HUB_EXCHANGE=kraken
HUB_AUTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HUB_AUTO_TIMEFRAME=4h

# --- risk guards, engaged ---
# The daily-loss kill switch defaults to 0 (off) in code so the test suite stays
# deterministic. A real deployment must turn it on; that is what this line does.
HUB_MAX_DAILY_LOSS=0.03
HUB_MAX_DRAWDOWN=0.20

# --- telemetry ---
# Unset this and tracing turns itself off; nothing else needs changing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
HUB_TRACE_SAMPLE=0.1

# --- web ---
# Leave unset and the app allows every origin and warns on each boot.
HUB_CORS_ORIGINS=https://www.trade-logx.com,https://trade-logx.com
